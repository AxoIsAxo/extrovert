<%- include('../partials/header') %>
  <div class="card">
    <h2 style="margin-top:0">Room Settings — <%= room.name %></h2>
    <form method="post" action="/rooms/<%= room.id %>/settings">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Room name</label>
      <input type="text" name="name" value="<%= room.name %>" maxlength="60" required>
      <label>Description</label>
      <input type="text" name="description" value="<%= room.description %>" maxlength="200">
      <label>Banner HTML <span class="muted">(no &lt;script&gt;, no JS — stripped automatically)</span></label>
      <textarea name="html" rows="8" spellcheck="false"><%= room.html %></textarea>
      <label>Room CSS <span class="muted">(styles the entire room page)</span></label>
      <textarea name="css" rows="8" spellcheck="false"><%= room.css %></textarea>
      <label style="margin-top:12px">Privacy</label>
      <div style="display:flex;gap:16px;margin-bottom:8px">
        <label style="font-weight:400;font-size:14px"><input type="radio" name="is_public" value="1" <%= room.is_public ? 'checked' : '' %>> Public</label>
        <label style="font-weight:400;font-size:14px"><input type="radio" name="is_public" value="0" <%= !room.is_public ? 'checked' : '' %>> Private</label>
      </div>
      <div style="margin-top:16px">
        <button class="btn">Save</button>
        <a class="btn ghost" href="/rooms/<%= room.id %>">Back</a>
      </div>
    </form>
    <hr>
    <form method="post" action="/rooms/<%= room.id %>/delete" class="delete-room-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <p class="muted" style="color:var(--error)">Danger zone: deleting a room is permanent and irreversible.</p>
      <label>Type <strong style="color:var(--error)">DELETE</strong> to confirm</label>
      <input type="text" name="confirm_delete" placeholder="DELETE" required>
      <label>Type the room name <strong><%= room.name %></strong> to confirm</label>
      <input type="text" name="confirm_name" placeholder="<%= room.name %>" required>
      <button class="btn danger" style="margin-top:8px">Delete Room</button>
    </form>
  </div>
  <script src="/static/rooms.js?v=1"></script>
<%- include('../partials/footer') %>