<%- include('../partials/header') %>
  <div class="card" style="max-width:560px;margin:0 auto">
    <h2 style="margin-top:0">Create a room</h2>
    <form method="post" action="/rooms/create">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Room name</label>
      <input type="text" name="name" maxlength="60" required>
      <label>Description <span class="muted">(optional)</span></label>
      <input type="text" name="description" maxlength="200">
      <label>Room type</label>
      <div style="margin:8px 0;display:flex;gap:16px">
        <label style="display:inline-flex;align-items:center;gap:6px;cursor:pointer;font-weight:400;font-size:var(--fs-sm)">
          <input type="radio" name="is_public" value="1" checked> Public
        </label>
        <label style="display:inline-flex;align-items:center;gap:6px;cursor:pointer;font-weight:400;font-size:var(--fs-sm)">
          <input type="radio" name="is_public" value="0"> Private
        </label>
      </div>
      <div style="margin-top:18px;display:flex;gap:10px">
        <button class="btn"><%- include('../partials/icon', { name: 'check', size: 15 }) %> Create</button>
        <a class="btn ghost" href="/rooms">Cancel</a>
      </div>
    </form>
  </div>
<%- include('../partials/footer') %>