<%- include('../partials/header') %>
  <div class="card">
    <div style="display:flex;justify-content:space-between;align-items:center">
      <h2 style="margin:0">Members — <%= room.name %></h2>
      <a class="btn" href="/rooms/<%= room.id %>">Back</a>
    </div>
  </div>

  <% if (!room.is_public) { %>
    <div class="card">
      <h3>Invite User</h3>
      <form method="post" action="/rooms/<%= room.id %>/invite" style="display:flex;gap:8px;align-items:center">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="text" name="username" placeholder="Username" required style="flex:1">
        <button class="btn">Invite</button>
      </form>
    </div>
  <% } %>

  <% if (requests.length) { %>
    <div class="card">
      <h3>Pending Requests (<%= requests.length %>)</h3>
      <% requests.forEach(function(r) { %>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:2px solid var(--border-light)">
          <div style="display:flex;align-items:center;gap:8px">
            <% if (r.avatar) { %><img src="<%= r.avatar %>" alt="" class="avatar-img"><% } else { %><div class="avatar"><%= (r.display_name || '?').slice(0,1).toUpperCase() %></div><% } %>
            <span><%= r.display_name %> <small class="muted">@<%= r.username %></small></span>
          </div>
          <div style="display:flex;gap:4px">
            <form method="post" action="/rooms/<%= room.id %>/requests/<%= r.id %>/approve" style="margin:0"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" style="font-size:12px;padding:4px 10px">Approve</button></form>
            <form method="post" action="/rooms/<%= room.id %>/requests/<%= r.id %>/reject" style="margin:0"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn ghost danger" style="font-size:12px;padding:4px 10px">Reject</button></form>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <div class="card">
    <h3>Members (<%= members.length %>)</h3>
    <% members.forEach(function(m) { %>
      <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:2px solid var(--border-light)">
        <div style="display:flex;align-items:center;gap:8px">
          <% var mRole = roles.find(function(r) { return r.id === m.role_id; }); %>
          <% if (m.avatar) { %><img src="<%= m.avatar %>" alt="" class="avatar-img"><% } else { %><div class="avatar"><%= (m.display_name || '?').slice(0,1).toUpperCase() %></div><% } %>
          <div>
            <a href="/u/<%= m.username %>"><%= m.display_name %></a>
            <span style="color:<%= mRole ? mRole.color : '#ccc' %>;font-size:12px"><%= mRole ? mRole.name : '' %></span>
            <small class="muted" style="display:block">@<%= m.username %></small>
          </div>
        </div>
        <div style="display:flex;gap:4px;align-items:center">
          <form method="post" action="/rooms/<%= room.id %>/members/<%= m.user_id %>/setrole" style="margin:0;display:flex;gap:4px;align-items:center">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <select name="role_id" style="font-size:12px;padding:4px">
              <% roles.forEach(function(r) { %>
                <option value="<%= r.id %>" <%= m.role_id === r.id ? 'selected' : '' %> <%= r.is_founder ? 'disabled' : '' %>><%= r.name %></option>
              <% }) %>
            </select>
            <button class="btn" style="font-size:12px;padding:4px 10px">Set</button>
          </form>
          <% if (!mRole || !mRole.is_founder) { %>
            <form method="post" action="/rooms/<%= room.id %>/members/<%= m.user_id %>/kick" style="margin:0"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn ghost danger" style="font-size:12px;padding:4px 10px">Kick</button></form>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>

  <div class="card">
    <h3>Transfer Founder</h3>
    <p class="muted">Only the current founder can transfer. This action is irreversible.</p>
    <form method="post" action="/rooms/<%= room.id %>/transfer">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>New founder</label>
      <select name="user_id" required>
        <% members.forEach(function(m) { %>
          <option value="<%= m.user_id %>"><%= m.display_name %> (@<%= m.username %>)</option>
        <% }) %>
      </select>
      <button class="btn danger" style="margin-top:8px">Transfer Founder Role</button>
    </form>
  </div>
<%- include('../partials/footer') %>