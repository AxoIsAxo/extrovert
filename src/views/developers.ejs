<%- include('partials/header') %>
<div style="max-width:600px;margin:0 auto">
  <h2>Developer Applications</h2>

  <% if (locals.error) { %><div class="flash err"><%= error %></div><% } %>

  <div class="card" style="margin-bottom:20px">
    <h3>Register a new application</h3>
    <form method="post" action="/settings/developers">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Name *</label>
      <input type="text" name="name" required>

      <label>Description</label>
      <input type="text" name="description">

      <label>Website</label>
      <input type="text" name="website" placeholder="https://example.com">

      <label>Redirect URIs *</label>
      <input type="text" name="redirect_uris" placeholder="https://example.com/callback, https://example.com/alt-callback" required>

      <label>Scopes (space-separated)</label>
      <input type="text" name="scopes" placeholder="read profile write" value="read">

      <div style="margin-top:18px">
        <button class="btn" style="width:100%">Register Application</button>
      </div>
    </form>
  </div>

  <% if (apps.length > 0) { %>
    <h3>Your registered applications</h3>
    <% apps.forEach(function(app) { %>
      <div class="card" style="margin-bottom:12px">
        <div style="display:flex;justify-content:space-between;align-items:start">
          <div>
            <strong style="font-size:1.1rem"><%= app.name %></strong>
            <% if (app.website) { %><div style="font-size:0.85rem;margin-top:2px"><a href="<%= app.website %>" target="_blank" rel="noopener"><%= app.website %></a></div><% } %>
          </div>
          <form method="post" action="/settings/developers/<%= app.id %>/delete" onsubmit="return confirm('Delete this application? All tokens issued to it will be revoked.')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn danger" style="font-size:0.8rem;padding:4px 10px;min-height:auto">Delete</button>
          </form>
        </div>
        <details style="margin-top:8px;font-size:0.85rem">
          <summary style="cursor:pointer;color:var(--primary)">Credentials</summary>
          <p style="margin:8px 0 4px"><strong>Client ID:</strong></p>
          <code style="display:block;padding:8px;background:var(--surface-container-high);border-radius:var(--radius-field);word-break:break-all"><%= app.client_id %></code>
          <% if (app.client_secret) { %>
            <p style="margin:8px 0 4px"><strong>Client Secret:</strong> <span style="color:var(--on-surface-variant);font-size:0.85rem">(shown once — copy it now)</span></p>
            <code style="display:block;padding:8px;background:var(--surface-container-high);border-radius:var(--radius-field);word-break:break-all"><%= app.client_secret %></code>
          <% } %>
          <p style="margin:8px 0 4px"><strong>Redirect URIs:</strong></p>
          <code style="display:block;padding:8px;background:var(--surface-container-high);border-radius:var(--radius-field)"><%= app.redirect_uris %></code>
          <p style="margin:8px 0 4px"><strong>Scopes:</strong> <code><%= app.scopes %></code></p>
        </details>
      </div>
    <% }); %>
  <% } else { %>
    <p style="text-align:center;color:var(--on-surface-variant);padding:24px">You haven't registered any applications yet.</p>
  <% } %>

  <hr style="border:none;border-top:1px solid var(--outline-variant);margin:24px 0">

  <h3>Authorized applications</h3>
  <% if (authorizedApps.length > 0) { %>
    <% authorizedApps.forEach(function(app) { %>
      <div class="card" style="margin-bottom:12px;display:flex;justify-content:space-between;align-items:center">
        <div>
          <strong><%= app.name %></strong>
          <% if (app.website) { %><div style="font-size:0.85rem;margin-top:2px"><a href="<%= app.website %>" target="_blank" rel="noopener"><%= app.website %></a></div><% } %>
          <br><code style="font-size:0.8rem">scopes: <%= app.scopes %></code>
        </div>
        <form method="post" action="/settings/developers/authorized/<%= app.client_id %>/revoke" onsubmit="return confirm('Revoke access for this application?')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn danger" style="font-size:0.8rem;padding:4px 10px;min-height:auto">Revoke</button>
        </form>
      </div>
    <% }); %>
  <% } else { %>
    <p style="text-align:center;color:var(--on-surface-variant);padding:24px">No authorized applications.</p>
  <% } %>
</div>
<%- include('partials/footer') %>