<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= profileUser.display_name %> (@<%= profileUser.username %>) · Extrovert</title>
  <link rel="stylesheet" href="/static/app.css">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <script src="/static/e2ee.js"></script>
  <script src="/static/copy-ref.js?v=2"></script>
  <style><%- css %></style>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="wrap">
    <div class="profile-header">
      <div class="avatar"><%= (profileUser.display_name || profileUser.username).slice(0,1).toUpperCase() %></div>
      <div>
        <div style="display:flex;align-items:center;gap:8px">
          <h1 style="margin:0"><%= profileUser.display_name %></h1>
          <% if (locals.currentUser && !isOwn) { %>
            <% if (mutual) { %>
              <a href="/chats/<%= profileUser.username %>" class="chat-icon" title="Send message">💬</a>
            <% } else { %>
              <span class="chat-icon locked" title="Follow each other to chat">💬</span>
            <% } %>
          <% } %>
        </div>
        <div class="handle">@<%= profileUser.username %></div>
        <% if (profileUser.bio) { %><p class="bio"><%= profileUser.bio %></p><% } %>
        <small class="muted">
          <a href="/u/<%= profileUser.username %>/followers"><%= followerCount %> follower<%= followerCount === 1 ? '' : 's' %></a>
          · <a href="/u/<%= profileUser.username %>/following"><%= followingCount %> following</a>
          <% if (referralCount > 0) { %>
            · <span class="referral-badge" title="<%= referralCount %> person<%= referralCount === 1 ? '' : 's' %> referred">★<%= referralCount %></span>
          <% } %>
        </small>
      </div>
      <span class="spacer"></span>
      <% if (locals.currentUser) { %>
        <% if (isOwn) { %>
          <a class="btn ghost" href="/u/<%= profileUser.username %>/edit">Edit page</a>
          <% if (referralCode) { %>
            <button class="btn ghost copy-ref" data-link="<%= baseUrl %>/register?ref=<%= referralCode %>">Copy Referral</button>
          <% } else { %>
            <form method="post" action="/u/<%= profileUser.username %>/referral" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn ghost">Create referral</button></form>
          <% } %>
        <% } else if (following) { %>
          <form method="post" action="/unfollow/<%= profileUser.username %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn ghost">Following ✓</button></form>
        <% } else { %>
          <form method="post" action="/follow/<%= profileUser.username %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn">Follow</button></form>
        <% } %>
      <% } %>
    </div>

    <div class="ev-custom">
      <%- finalHtml %>
    </div>
  </main>
</body>
</html>
