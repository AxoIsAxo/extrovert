<nav class="nav">
  <a class="brand" href="/" aria-label="Extrovert home">
    <span class="brand-rings"><%- include('rings', { size: 22 }) %></span>
    Extrovert
  </a>
  <% if (locals.currentUser) { %>
    <a href="/" title="Feed"><span class="nav-icon"><%- include('icon', { name: 'home', size: 18 }) %></span><span class="nav-text">Feed</span></a>
    <a href="/chats" title="Chats"><span class="nav-icon"><%- include('icon', { name: 'chat', size: 18 }) %></span><span class="nav-text">Chats</span><% if (locals.unreadMessages > 0) { %><sup class="badge"><%= unreadMessages %></sup><% } %></a>
    <a href="/inbox" title="Notifications"><span class="nav-icon"><%- include('icon', { name: 'bell', size: 18 }) %></span><span class="nav-text">Notifications</span><% if (locals.unreadCount > 0) { %><sup class="badge"><%= unreadCount %></sup><% } %></a>
    <a href="/u/<%= currentUser.username %>" title="Profile"><span class="nav-icon"><%- include('icon', { name: 'user', size: 18 }) %></span><span class="nav-text">Profile</span></a>
    <a href="/rooms" title="Rooms"><span class="nav-icon"><%- include('icon', { name: 'rooms', size: 18 }) %></span><span class="nav-text">Rooms</span></a>
    <a href="/settings" title="Settings"><span class="nav-icon"><%- include('icon', { name: 'settings', size: 18 }) %></span><span class="nav-text">Settings</span></a>
    <% if (locals.currentUser && locals.currentUser.is_admin) { %><a href="/admin" title="Admin"><span class="nav-icon"><%- include('icon', { name: 'shield', size: 18 }) %></span><span class="nav-text">Admin</span><% if (locals.pendingReports > 0) { %><sup class="badge"><%= pendingReports %></sup><% } %></a><% } %>
    <span class="spacer"></span>
    <form method="post" action="/logout" style="margin:0"><input type="hidden" name="_csrf" value="<%= locals.csrfToken %>"><button title="Log out"><span class="nav-icon"><%- include('icon', { name: 'logout', size: 18 }) %></span><span class="nav-text">Log out</span></button></form>
  <% } else { %>
    <span class="spacer"></span>
    <a href="/login">Log in</a>
    <a class="btn" href="/register" style="min-height:34px">Sign up</a>
  <% } %>
</nav>