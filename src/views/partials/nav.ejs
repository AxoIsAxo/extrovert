<nav class="nav">
  <a class="brand" href="/">Extrovert</a>
  <% if (locals.currentUser) { %>
    <a href="/">Feed</a>
    <a href="/discover">Discover</a>
    <a href="/compose">Post</a>
    <a href="/chats">Chats<% if (locals.unreadMessages > 0) { %><sup class="badge"><%= unreadMessages %></sup><% } %></a>
    <a href="/inbox">Inbox<% if (locals.unreadCount > 0) { %><sup class="badge"><%= unreadCount %></sup><% } %></a>
    <a href="/u/<%= currentUser.username %>">Profile</a>
    <a href="/settings">Settings</a>
    <% if (locals.currentUser && locals.currentUser.is_admin) { %><a href="/admin">Admin</a><% } %>
    <span class="spacer"></span>
    <form method="post" action="/logout" style="margin:0"><input type="hidden" name="_csrf" value="<%= locals.csrfToken %>"><button>Log out</button></form>
  <% } else { %>
    <span class="spacer"></span>
    <a href="/login">Log in</a>
    <a href="/register">Sign up</a>
  <% } %>
</nav>
