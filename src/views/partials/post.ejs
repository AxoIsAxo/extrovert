<%
  const u = locals.currentUser;
  const time = locals.relTime || ((t) => new Date(t).toLocaleString());
%>
<article class="post">
  <% if (item.isRepost) { %>
    <div class="post-repost">🔁 <%= item.reposterName %> reposted this</div>
  <% } %>
  <header class="post-head">
    <% if (item.authorAvatar) { %><a class="post-avatar-link" href="/u/<%= item.authorUsername %>"><img src="<%= item.authorAvatar %>" alt="" class="post-avatar-img"></a><% } else { %><a class="post-avatar" href="/u/<%= item.authorUsername %>"><%= (item.authorName || '?').slice(0,1).toUpperCase() %></a><% } %>
    <div>
      <div style="display:flex;align-items:center;gap:4px">
        <a href="/u/<%= item.authorUsername %>" class="post-name"><%= item.authorName %></a>
        <% if (u && !item.isOwn) { %>
          <% if (item.mutual) { %>
            <a href="/chats/<%= item.authorUsername %>" class="chat-icon" title="Send message">💬</a>
          <% } else { %>
            <span class="chat-icon locked" title="Follow each other to chat">💬</span>
          <% } %>
        <% } %>
      </div>
      <span class="post-handle">@<%= item.authorUsername %></span>
      <span class="post-time">· <%= time(item.createdAt) %></span>
      <% if (item.editedAt) { %><span class="post-time edited-badge" title="<%= new Date(item.editedAt).toLocaleString() %>">· edited</span><% } %>
    </div>
  </header>

  <% if (item.body) { %><div class="post-body"><%= item.body %></div><% } %>
  <% if (item.editedAt) { %><div class="post-edited"><a href="/posts/<%= item.interactId %>/history?type=post" class="edited-link" title="<%= new Date(item.editedAt).toLocaleString() %>">(edited)</a></div><% } %>
  <% if (item.mediaPath && item.type === 'photo') { %>
    <img class="post-media" src="<%= item.mediaPath %>" alt="photo">
  <% } else if (item.mediaPath && item.type === 'video') { %>
    <video class="post-media" controls src="<%= item.mediaPath %>"></video>
  <% } %>

  <div class="post-stats">
    <span>❤️ <%= item.likeCount %></span>
    <span>💬 <%= item.commentCount %></span>
    <span>🔗 <%= item.shareCount %></span>
    <% if (item.followBoost > 0) { %><span class="boost">⭐ followed from post ×<%= item.followBoost %></span><% } %>
  </div>

  <% if (u) { %>
  <% const _token = typeof csrfToken !== 'undefined' ? csrfToken : (locals.csrfToken || ''); %>
  <div class="post-actions">
    <form method="post" action="/posts/<%= item.interactId %>/like">
      <input type="hidden" name="_csrf" value="<%= _token %>">
      <button class="<%= item.liked ? 'active' : '' %>"><%= item.liked ? '♥ Liked' : '♡ Like' %></button>
    </form>
    <form method="post" action="/posts/<%= item.interactId %>/share">
      <input type="hidden" name="_csrf" value="<%= _token %>">
      <button class="<%= item.shared ? 'active' : '' %>">Share</button>
    </form>
    <form method="post" action="/posts/<%= item.interactId %>/repost">
      <input type="hidden" name="_csrf" value="<%= _token %>">
      <button>Repost</button>
    </form>
    <% if (!item.isOwn && !item.followingAuthor) { %>
      <form method="post" action="/posts/<%= item.interactId %>/follow-from">
        <input type="hidden" name="_csrf" value="<%= _token %>">
        <button class="boost-btn">⭐ Follow from post</button>
      </form>
    <% } %>
    <% if (item.isOwn) { %>
      <button class="btn ghost edit-post-btn" data-post-id="<%= item.id %>" style="margin-left:auto">Edit</button>
      <a class="btn ghost" href="/posts/<%= item.interactId %>/delete" style="color:#c33">Delete</a>
    <% } %>
  </div>
  <% if (item.isOwn) { %>
    <form class="edit-post-form" method="post" action="/posts/<%= item.interactId %>/edit" style="display:none;margin-top:8px">
      <input type="hidden" name="_csrf" value="<%= _token %>">
      <textarea name="body" maxlength="5000" style="width:100%;min-height:80px"><%= item.body %></textarea>
      <div style="display:flex;gap:8px;margin-top:4px">
        <button class="btn" type="submit">Save</button>
        <button class="btn ghost cancel-edit-post" type="button">Cancel</button>
      </div>
    </form>
  <% } %>

  <div class="post-comments">
    <% (item.comments || []).forEach(function(c){ %>
      <div class="comment" data-comment-id="<%= c.id %>">
        <b><%= c.display_name %></b> <span class="post-handle">@<%= c.username %></span>
        <span class="post-time">· <%= time(c.created_at) %></span>
        <% if (c.edited_at) { %><a href="/posts/<%= c.id %>/history?type=comment&post_id=<%= item.interactId %>" class="edited-link" title="<%= new Date(c.edited_at).toLocaleString() %>">(edited)</a><% } %><br>
        <span class="comment-body"><% if (c.body && c.body.startsWith('/uploads/stickers/')) { %>
          <img src="<%= c.body %>" class="sticker-inline" style="max-width:120px;max-height:120px;vertical-align:middle" alt="sticker">
        <% } else { %>
          <%= c.body %>
        <% } %></span>
        <% if (u && c.user_id === u.id) { %>
          <button class="btn ghost edit-comment-btn" style="font-size:11px;padding:1px 6px">Edit</button>
          <form method="post" action="/posts/<%= item.interactId %>/comments/<%= c.id %>/delete" class="delete-comment-form" style="display:inline">
            <input type="hidden" name="_csrf" value="<%= _token %>">
            <button class="btn ghost delete-comment-btn" type="submit" style="font-size:11px;padding:1px 6px;color:#c33">Delete</button>
          </form>
          <form class="edit-comment-form" method="post" action="/posts/<%= item.interactId %>/comments/<%= c.id %>/edit" style="display:none;margin-top:4px">
            <input type="hidden" name="_csrf" value="<%= _token %>">
            <input type="text" name="body" value="<%= c.body %>" maxlength="1000" style="width:80%">
            <button class="btn" type="submit" style="font-size:11px;padding:2px 8px">Save</button>
            <button class="btn ghost cancel-edit-comment" type="button" style="font-size:11px;padding:2px 8px">Cancel</button>
          </form>
        <% } %>
      </div>
    <% }) %>
    <form class="comment-form" method="post" action="/posts/<%= item.interactId %>/comment" style="position:relative">
      <input type="hidden" name="_csrf" value="<%= _token %>">
      <input type="text" name="body" id="sticker-input-<%= item.interactId %>" placeholder="Add a comment…" maxlength="1000" required>
      <button>Comment</button>
      <button class="btn ghost sticker-btn" data-target="sticker-popup-<%= item.interactId %>" type="button" style="font-size:18px;padding:4px 8px">😀</button>
      <div id="sticker-popup-<%= item.interactId %>" style="display:none;position:absolute;bottom:100%;right:0;background:var(--card);border:1px solid var(--border);border-radius:8px;z-index:100;box-shadow:0 2px 8px rgba(0,0,0,.15)"></div>
    </form>
  </div>
  <% } %>
</article>
