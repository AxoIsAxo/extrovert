<%- include('partials/header') %>
  <div class="card" style="max-width:500px;margin:0 auto">
    <h2>My Stickers</h2>
    <form method="post" action="/stickers/upload" enctype="multipart/form-data" style="margin-bottom:16px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Upload sticker (max 250 KB, images &amp; GIFs)</label>
      <input type="file" name="sticker" accept="image/*" required>
      <button class="btn" type="submit" style="margin-top:8px">Upload</button>
    </form>
    <div style="display:flex;flex-wrap:wrap;gap:8px">
      <% stickers.forEach(function(s){ %>
        <img src="<%= s.file_path %>" class="sticker-thumb" alt="sticker" style="width:80px;height:80px;object-fit:contain;border-radius:var(--radius-lg);background:var(--surface-2)">
      <% }) %>
      <% if (stickers.length === 0) { %>
        <p class="muted">No stickers yet.</p>
      <% } %>
    </div>
  </div>
<%- include('partials/footer') %>
