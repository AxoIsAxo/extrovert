<%- include('partials/header') %>
  <div class="card" style="display:flex;justify-content:space-between;align-items:center">
    <div>
      <a href="/chats" class="muted" style="font-size:0.85rem">← Chats</a>
      <h2 style="margin:0;font-size:1.2rem"><%= other.display_name %></h2>
      <small class="muted">@<%= other.username %></small>
    </div>
    <a class="btn ghost" href="/u/<%= other.username %>">Profile</a>
  </div>

  <div class="chat-messages">
    <% if (messages.length === 0) { %>
      <div class="center muted" style="padding:2rem">No messages yet. Say hello!</div>
    <% } else { %>
      <% messages.forEach(function(m){ %>
        <div class="chat-msg <%= m.from_id === currentUser.id ? 'own' : '' %>"
             data-body="<%= m.body %>"
             data-key-sender="<%= m.key_for_sender || '' %>"
             data-key-recipient="<%= m.key_for_recipient || '' %>"
             data-msg-id="<%= m.id %>">
          <div class="chat-bubble"><%= m.key_for_sender ? '🔒' : '' %><% if (m.body && m.body.startsWith('/uploads/stickers/')) { %><img src="<%= m.body %>" class="sticker-inline" style="max-width:120px;max-height:120px;vertical-align:middle" alt="sticker"><% } else { %><%= m.body %><% } %></div>
          <div class="muted" style="font-size:0.7rem;padding:0 4px">
            <%= locals.relTime(m.created_at) %>
            <% if (m.edited_at) { %><span class="edited-indicator" title="<%= new Date(m.edited_at).toLocaleString() %>">· edited</span><% } %>
            <% if (m.from_id === currentUser.id) { %>
              <button class="btn ghost edit-msg-btn" style="font-size:10px;padding:0 4px;margin-left:4px">Edit</button>
            <% } %>
          </div>
          <% if (m.from_id === currentUser.id) { %>
            <form class="edit-msg-form" method="post" action="/chats/<%= other.username %>/edit/<%= m.id %>" style="display:none;margin-top:2px">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="text" name="body" value="<%= m.body %>" maxlength="2000" style="width:80%">
              <button class="btn" type="submit" style="font-size:11px;padding:2px 8px">Save</button>
              <button class="btn ghost cancel-edit-msg" type="button" style="font-size:11px;padding:2px 8px">Cancel</button>
            </form>
          <% } %>
        </div>
      <% }) %>
    <% } %>
  </div>

  <form class="chat-form" method="post" action="/chats/<%= other.username %>/send" data-pubkey="<%= recipientPubKey || '' %>" style="position:relative">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="text" name="body" id="sticker-input-chat" placeholder="Type a message…" maxlength="2000" required autofocus>
    <button>Send</button>
    <button class="btn ghost sticker-btn" data-target="sticker-popup-chat" type="button" style="font-size:18px;padding:4px 8px">😀</button>
    <div id="sticker-popup-chat" style="display:none;position:absolute;bottom:100%;right:0;background:var(--card);border:1px solid var(--border);border-radius:8px;z-index:100;box-shadow:0 2px 8px rgba(0,0,0,.15)"></div>
  </form>
<%- include('partials/footer') %>
