<%- include('partials/header') %>
  <div class="card" style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
    <div>
      <a href="/chats" class="muted" style="font-size:0.85rem;display:inline-flex;align-items:center;gap:4px"><%- include('partials/icon', { name: 'arrowLeft', size: 13 }) %> Chats</a>
      <h2 style="margin:2px 0 0;font-size:var(--fs-lg)"><%= other.display_name %></h2>
      <small class="muted">@<%= other.username %></small>
    </div>
    <div style="display:flex;gap:8px">
      <button class="btn ghost call-btn" data-username="<%= other.username %>" data-display="<%= other.display_name %>"><%- include('partials/icon', { name: 'phone', size: 15 }) %> Call</button>
      <a class="btn ghost" href="/u/<%= other.username %>"><%- include('partials/icon', { name: 'user', size: 15 }) %> Profile</a>
    </div>
  </div>

  <div class="chat-messages">
    <% if (messages.length === 0) { %>
      <div class="center muted" style="padding:2rem">No messages yet — say hello.</div>
    <% } else { %>
      <% messages.forEach(function(m){ %>
        <div class="chat-msg <%= m.from_id === currentUser.id ? 'own' : '' %>"
             data-body="<%= m.body %>"
             data-key-sender="<%= m.key_for_sender || '' %>"
             data-key-recipient="<%= m.key_for_recipient || '' %>"
             data-msg-id="<%= m.id %>">
          <div class="chat-bubble"><% if (m.key_for_sender) { %><span title="End-to-end encrypted"><%- include('partials/icon', { name: 'lock', size: 13 }) %></span> <% } %><% if (m.body && m.body.startsWith('/uploads/stickers/')) { %><img src="<%= m.body %>" class="sticker-inline" style="max-width:120px;max-height:120px;vertical-align:middle" alt="sticker"><% } else { %><%= m.body %><% } %></div>
          <div class="muted" style="font-size:0.7rem;padding:0 4px">
            <%= locals.relTime(m.created_at) %>
            <% if (m.edited_at) { %><span class="edited-indicator" title="<%= new Date(m.edited_at).toLocaleString() %>">· edited</span><% } %>
            <% if (m.from_id === currentUser.id) { %>
              <button class="edit-msg-btn" style="font-size:0.7rem;color:var(--text-muted);background:none;border:none;cursor:pointer;padding:0 2px;margin-left:4px;text-decoration:underline">Edit</button>
            <% } %>
          </div>
          <% if (m.from_id === currentUser.id) { %>
            <input type="hidden" class="edit-msg-data" value="<%= m.body %>" data-csrf="<%= csrfToken %>" data-action="/chats/<%= other.username %>/edit/<%= m.id %>">
          <% } %>
        </div>
      <% }) %>
    <% } %>
  </div>

  <form class="chat-form" method="post" action="/chats/<%= other.username %>/send" data-pubkey="<%= recipientPubKey || '' %>" style="position:relative">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="text" name="body" id="sticker-input-chat" placeholder="Type a message…" maxlength="2000" required autofocus>
    <button><%- include('partials/icon', { name: 'arrowRight', size: 16 }) %> Send</button>
    <button class="btn ghost sticker-btn" data-target="sticker-popup-chat" type="button" style="padding:6px 10px" title="Stickers"><%- include('partials/icon', { name: 'smile', size: 18 }) %></button>
    <div id="sticker-popup-chat" style="display:none;position:absolute;bottom:100%;right:0;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);z-index:100;box-shadow:var(--shadow)"></div>
  </form>
<%- include('partials/footer') %>