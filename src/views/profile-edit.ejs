<%- include('partials/header') %>
  <div class="card">
    <h2 style="margin-top:0">Edit your profile</h2>

    <div style="display:flex;align-items:center;gap:16px;margin-bottom:20px">
      <% if (profileUser.avatar) { %>
        <img src="<%= profileUser.avatar %>" alt="" class="avatar-preview">
      <% } else { %>
        <div class="avatar-preview"><%= (profileUser.display_name || '?').slice(0,1).toUpperCase() %></div>
      <% } %>
      <div>
        <form method="post" action="/u/<%= profileUser.username %>/avatar" enctype="multipart/form-data" style="margin:0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="file" name="avatar" accept="image/*" required style="display:none" id="avatarInput">
          <button class="btn ghost" type="button" id="avatarUploadBtn">Upload photo</button>
          <small class="muted" style="display:block;margin-top:4px">Square JPEG/PNG, max 5 MB</small>
        </form>
        <% if (profileUser.avatar) { %>
          <form method="post" action="/u/<%= profileUser.username %>/avatar/remove" style="margin:4px 0 0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn ghost danger" style="font-size:12px">Remove</button>
          </form>
        <% } %>
      </div>
    </div>

    <form method="post" action="/u/<%= profileUser.username %>/edit">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Display name</label>
      <input type="text" name="displayName" value="<%= displayName %>" maxlength="60">

      <label>Bio</label>
      <textarea name="bio" rows="2" maxlength="280"><%= bio %></textarea>

      <label>Profile HTML <span class="muted">(no &lt;script&gt;, no JS — stripped automatically)</span></label>
      <textarea name="html" rows="10" spellcheck="false"><%= html %></textarea>
      <small class="muted">Put <code>&lt;!--POSTS--&gt;</code> where you want your posts to appear. If omitted, posts are shown at the end.</small>

      <label>Profile CSS <span class="muted">(styles the whole page)</span></label>
      <textarea name="css" rows="10" spellcheck="false"><%= css %></textarea>

      <div style="margin-top:16px">
        <button class="btn">Save</button>
        <a class="btn ghost" href="/u/<%= profileUser.username %>">Cancel</a>
      </div>
    </form>
  </div>
  <script src="/avatar.js?v=1"></script>
<%- include('partials/footer') %>
