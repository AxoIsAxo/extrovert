<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Extrovert API &#x2014; Docs</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swagger-ui-dist@5.17.14/swagger-ui.css">
  <style>
    :root {
      --primary: #7ec8e3;
      --on-primary: #003545;
      --primary-container: #004d64;
      --on-primary-container: #c2e8ff;
      --secondary: #aac7dc;
      --on-secondary: #113140;
      --secondary-container: #294857;
      --on-secondary-container: #c8e5fa;
      --surface: #121214;
      --surface-dim: #0c0c0e;
      --surface-container: #1c1c1f;
      --surface-container-low: #18181b;
      --surface-container-high: #26262a;
      --surface-container-highest: #303035;
      --on-surface: #e0dfe3;
      --on-surface-variant: #b8b7bd;
      --outline: #808187;
      --outline-variant: #38383d;
      --error: #ffb4ab;
      --error-container: #93000a;
      --radius-card: 16px;
      --radius-btn: 20px;
      --radius-field: 12px;
    }

    body {
      margin: 0;
      background: var(--surface);
      font-family: -apple-system, BlinkMacSystemFont, "Google Sans", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    /* ---- Base text color ---- */
    .swagger-ui, .swagger-ui * {
      color: var(--on-surface) !important;
    }

    /* ---- Links ---- */
    .swagger-ui a, .swagger-ui a:link, .swagger-ui a:visited {
      color: var(--primary) !important;
    }
    .swagger-ui a:hover {
      color: #a8def5 !important;
    }

    /* ---- Muted/secondary text ---- */
    .swagger-ui .opblock-summary-description,
    .swagger-ui .opblock-tag small,
    .swagger-ui .parameter__type,
    .swagger-ui .parameter__in,
    .swagger-ui .parameter__deprecated,
    .swagger-ui .info .base-url,
    .swagger-ui .info .description p,
    .swagger-ui .info__tos,
    .swagger-ui .info__extdocs,
    .swagger-ui .opblock-description-wrapper p,
    .swagger-ui .opblock-external-docs-wrapper p,
    .swagger-ui .response-col_links,
    .swagger-ui .response-col_description__inner div.markdown p,
    .swagger-ui .responses-inner p,
    .swagger-ui .markdown p,
    .swagger-ui .markdown li,
    .swagger-ui .markdown table,
    .swagger-ui .loading-container .loading,
    .swagger-ui .response-control-media-type,
    .swagger-ui table thead tr td,
    .swagger-ui table thead tr th,
    .swagger-ui .servers label,
    .swagger-ui .opblock .tab-header .tab-item,
    .swagger-ui .errors-wrapper .errors small,
    .swagger-ui .dialog-ux .modal-ux-content label,
    .swagger-ui .model .prop-type,
    .swagger-ui .model .prop-format,
    .swagger-ui .model .property,
    .swagger-ui .opblock-section-header .btn,
    .swagger-ui .btn.cancel {
      color: var(--on-surface-variant) !important;
    }

    /* ---- Error text ---- */
    .swagger-ui .errors,
    .swagger-ui .parameter__name.required span,
    .swagger-ui .parameter__deprecated,
    .swagger-ui .errors-wrapper hgroup h4,
    .swagger-ui .errors-wrapper .errors h4 {
      color: var(--error) !important;
    }

    /* ---- Method badges ---- */
    .swagger-ui .opblock .opblock-summary-method {
      border-radius: var(--radius-field) !important;
      font-size: 12px !important;
      font-weight: 700 !important;
      padding: 4px 10px !important;
      min-width: 58px !important;
      text-align: center !important;
      border: none !important;
    }
    .swagger-ui .opblock.opblock-get .opblock-summary-method {
      background: var(--primary-container) !important;
      color: var(--on-primary-container) !important;
    }
    .swagger-ui .opblock.opblock-post .opblock-summary-method,
    .swagger-ui .opblock.opblock-put .opblock-summary-method {
      background: var(--secondary-container) !important;
      color: var(--on-secondary-container) !important;
    }
    .swagger-ui .opblock.opblock-patch .opblock-summary-method {
      background: var(--surface-container-highest) !important;
      color: var(--on-surface) !important;
    }
    .swagger-ui .opblock.opblock-delete .opblock-summary-method {
      background: var(--error-container) !important;
      color: var(--error) !important;
    }

    /* ---- Top bar ---- */
    .topbar {
      display: block !important;
      background: var(--surface-container) !important;
      border-bottom: 1px solid var(--outline-variant) !important;
    }
    .topbar .wrapper {
      display: flex !important;
      align-items: center !important;
      gap: 12px !important;
      max-width: 1460px !important;
      margin: 0 auto !important;
      padding: 0 20px !important;
      min-height: 56px !important;
    }
    .topbar .topbar-wrapper {
      display: flex !important;
      align-items: center !important;
      gap: 12px !important;
      flex: 1 !important;
    }
    .topbar .topbar-wrapper .link {
      display: flex !important;
      align-items: center !important;
      gap: 10px !important;
      text-decoration: none !important;
    }
    .topbar .topbar-wrapper .link img { display: none !important; }
    .topbar .topbar-wrapper .link span {
      font-size: 20px !important;
      font-weight: 700 !important;
      color: var(--on-surface) !important;
      letter-spacing: -0.3px !important;
    }
    .topbar .download-url-wrapper { display: none !important; }
    .topbar .select-label {
      color: var(--on-surface-variant) !important;
      font-size: 13px !important;
    }
    .topbar .extrovert-logo {
      width: 28px !important;
      height: 28px !important;
      background: var(--primary) !important;
      border-radius: 50% !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      font-weight: 800 !important;
      font-size: 14px !important;
      color: var(--on-primary) !important;
      flex: none !important;
      text-decoration: none !important;
    }

    /* ---- Info ---- */
    .swagger-ui .info { margin: 30px 0 20px !important; }
    .swagger-ui .info .title {
      font-weight: 600 !important;
      letter-spacing: -0.3px !important;
      font-size: 28px !important;
    }
    .swagger-ui .info .title small.version-stamp {
      background: var(--primary-container) !important;
      color: var(--on-primary-container) !important;
      border-radius: var(--radius-btn) !important;
      padding: 4px 14px !important;
    }
    .swagger-ui .info hgroup.main { margin-bottom: 20px !important; }

    /* ---- Servers ---- */
    .swagger-ui .servers { margin: 16px 0 !important; }
    .swagger-ui .servers select {
      background: var(--surface-container) !important;
      border: 1px solid var(--outline-variant) !important;
      color: var(--on-surface) !important;
      border-radius: var(--radius-field) !important;
      padding: 10px 14px !important;
      font-size: 14px !important;
      font-family: inherit !important;
    }
    .swagger-ui .servers select:focus {
      border-color: var(--primary) !important;
      outline: none !important;
    }

    /* ---- Scheme ---- */
    .swagger-ui .scheme-container {
      background: var(--surface-container-low) !important;
      border: 1px solid var(--outline-variant) !important;
      border-radius: var(--radius-card) !important;
      box-shadow: none !important;
      padding: 16px 24px !important;
      margin: 16px 0 !important;
    }
    .swagger-ui .scheme-container .auth-wrapper .authorize {
      background: transparent !important;
      border: 1px solid var(--primary) !important;
      border-radius: var(--radius-btn) !important;
      padding: 8px 20px !important;
      font-weight: 600 !important;
      font-size: 14px !important;
      font-family: inherit !important;
    }
    .swagger-ui .scheme-container .auth-wrapper .authorize:hover {
      background: rgba(126,200,227,.08) !important;
    }
    .swagger-ui .scheme-container .auth-wrapper .authorize svg { fill: var(--primary) !important; }

    /* ---- Operation blocks ---- */
    .swagger-ui .opblock-tag {
      border-bottom: 1px solid var(--outline-variant) !important;
      padding: 14px 0 !important;
    }
    .swagger-ui .opblock-tag:hover { background: transparent !important; }
    .swagger-ui .opblock-tag .nostyle {
      font-weight: 600 !important;
      font-size: 18px !important;
      letter-spacing: -0.2px !important;
    }
    .swagger-ui .opblock {
      border-radius: var(--radius-card) !important;
      border: 1px solid var(--outline-variant) !important;
      margin: 0 0 12px !important;
      background: var(--surface-container-low) !important;
      box-shadow: none !important;
    }
    .swagger-ui .opblock .opblock-summary {
      padding: 10px 16px !important;
      border-bottom: none !important;
    }
    .swagger-ui .opblock.opblock-get,
    .swagger-ui .opblock.opblock-post,
    .swagger-ui .opblock.opblock-put,
    .swagger-ui .opblock.opblock-patch,
    .swagger-ui .opblock.opblock-delete {
      border-color: var(--outline-variant) !important;
    }
    .swagger-ui .opblock .opblock-summary .view-line-link { fill: var(--on-surface-variant) !important; }
    .swagger-ui .opblock .opblock-summary .arrow { fill: var(--on-surface-variant) !important; }

    .swagger-ui .opblock .opblock-section-header {
      background: var(--surface-container) !important;
      border-bottom: 1px solid var(--outline-variant) !important;
      border-radius: var(--radius-card) var(--radius-card) 0 0 !important;
      padding: 12px 16px !important;
      min-height: 44px !important;
      box-shadow: none !important;
    }
    .swagger-ui .opblock .opblock-section-header h4 {
      font-weight: 600 !important;
      font-size: 14px !important;
    }
    .swagger-ui .opblock .opblock-section-header .btn {
      background: transparent !important;
      border: 1px solid var(--outline-variant) !important;
      border-radius: var(--radius-btn) !important;
      padding: 6px 16px !important;
      font-size: 13px !important;
      font-weight: 500 !important;
    }
    .swagger-ui .opblock .opblock-section-header .btn:hover {
      border-color: var(--primary) !important;
    }

    /* ---- Tabs ---- */
    .swagger-ui .opblock .tab-header { text-align: left !important; }
    .swagger-ui .opblock .tab-header .tab-item { font-size: 14px !important; }
    .swagger-ui .opblock .tab-header .tab-item.active h4 span { color: var(--primary) !important; }
    .swagger-ui .opblock .tab-header .tab-item.active { color: var(--primary) !important; }
    .swagger-ui .opblock .tab-header .tab-item:first-of-type { padding-left: 0 !important; }

    /* ---- Parameters ---- */
    .swagger-ui .parameters-container { border: none !important; }
    .swagger-ui .parameters-col_name { font-size: 14px !important; }
    .swagger-ui .parameter__name { font-size: 14px !important; }
    .swagger-ui .parameter__name.required { font-weight: 600 !important; }
    .swagger-ui .parameter__name.required span { color: var(--error) !important; }
    .swagger-ui .parameter__type { font-size: 12px !important; }
    .swagger-ui .parameter__in { font-size: 12px !important; }
    .swagger-ui table thead tr td,
    .swagger-ui table thead tr th {
      border-bottom: 1px solid var(--outline-variant) !important;
      font-size: 13px !important;
      font-weight: 500 !important;
    }
    .swagger-ui table tbody tr td {
      border-bottom: 1px solid var(--outline-variant) !important;
      font-size: 14px !important;
    }

    /* ---- Responses ---- */
    .swagger-ui .response {
      border: 1px solid var(--outline-variant) !important;
      border-radius: var(--radius-card) !important;
      overflow: hidden !important;
    }
    .swagger-ui .responses-inner h4,
    .swagger-ui .responses-inner h5 { font-weight: 600 !important; }
    .swagger-ui .response .response-col_status .response-undocumented { color: var(--on-surface-variant) !important; }
    .swagger-ui .responses-wrapper .responses-header h4 { font-weight: 600 !important; }
    .swagger-ui .highlight-code {
      background: var(--surface-dim) !important;
      border-radius: 0 0 var(--radius-card) var(--radius-card) !important;
    }
    .swagger-ui .highlight-code .lang-react { display: none !important; }
    .swagger-ui .highlight-code .copy-to-clipboard {
      background: var(--surface-container) !important;
      border: 1px solid var(--outline-variant) !important;
      border-radius: var(--radius-btn) !important;
      padding: 4px 12px !important;
      font-size: 12px !important;
    }
    .swagger-ui .response-col_description__inner pre,
    .swagger-ui .opblock-body pre.microlight {
      background: var(--surface-dim) !important;
      border-radius: var(--radius-field) !important;
      border: 1px solid var(--outline-variant) !important;
      font-size: 13px !important;
    }
    .swagger-ui .response-col_description__inner span { color: var(--on-surface-variant) !important; }
    .swagger-ui .response-controls { padding: 8px 16px !important; }
    .swagger-ui .response-controls .response-control-media-type { font-size: 13px !important; }
    .swagger-ui .response-controls .response-control-media-type--accept-controller select,
    .swagger-ui .content-type-wrapper select {
      background: var(--surface-container) !important;
      border: 1px solid var(--outline-variant) !important;
      border-radius: var(--radius-field) !important;
      padding: 6px 10px !important;
      font-size: 13px !important;
      font-family: inherit !important;
    }

    /* ---- Models ---- */
    .swagger-ui .model-title .model-title__text { font-weight: 600 !important; }
    .swagger-ui .model-container {
      background: var(--surface-container) !important;
      border-radius: var(--radius-field) !important;
      border: 1px solid var(--outline-variant) !important;
      box-shadow: none !important;
      margin: 8px 0 !important;
    }
    .swagger-ui .responses-inner .model-box {
      background: var(--surface-container) !important;
      border-radius: 12px !important;
      border: 1px solid var(--outline-variant) !important;
    }

    /* ---- Markdown ---- */
    .swagger-ui .markdown code {
      background: var(--surface-container-high) !important;
      border-radius: 6px !important;
      padding: 2px 8px !important;
      font-size: 13px !important;
    }
    .swagger-ui .markdown pre {
      background: var(--surface-dim) !important;
      border-radius: var(--radius-field) !important;
      border: 1px solid var(--outline-variant) !important;
    }

    /* ---- Buttons ---- */
    .swagger-ui .btn {
      background: transparent !important;
      border: 1px solid var(--primary) !important;
      border-radius: var(--radius-btn) !important;
      padding: 8px 20px !important;
      font-size: 14px !important;
      font-weight: 600 !important;
      font-family: inherit !important;
      box-shadow: none !important;
    }
    .swagger-ui .btn:hover { background: rgba(126,200,227,.08) !important; }
    .swagger-ui .btn.execute { background: var(--primary) !important; border: none !important; }
    .swagger-ui .btn.execute:hover { background: var(--primary-container) !important; }
    .swagger-ui .btn.cancel { border: 1px solid var(--outline-variant) !important; }

    /* ---- Auth modal ---- */
    .swagger-ui .dialog-ux .backdrop-ux { background: rgba(0,0,0,.6) !important; }
    .swagger-ui .dialog-ux .modal-ux {
      background: var(--surface) !important;
      border: 1px solid var(--outline-variant) !important;
      border-radius: var(--radius-card) !important;
      box-shadow: 0 8px 32px rgba(0,0,0,.4) !important;
    }
    .swagger-ui .dialog-ux .modal-ux-header {
      border-bottom: 1px solid var(--outline-variant) !important;
      padding: 16px 24px !important;
    }
    .swagger-ui .dialog-ux .modal-ux-header h3 {
      font-weight: 600 !important;
      font-size: 18px !important;
    }
    .swagger-ui .dialog-ux .modal-ux-header .close-modal { fill: var(--on-surface-variant) !important; }
    .swagger-ui .dialog-ux .modal-ux-content h4 { font-weight: 600 !important; }
    .swagger-ui .dialog-ux .modal-ux-content label { font-size: 13px !important; }
    .swagger-ui .dialog-ux .modal-ux-content .auth-btn-wrapper { gap: 8px !important; }
    .swagger-ui .auth-btn-wrapper .btn-done {
      background: var(--primary) !important;
      border: none !important;
      border-radius: var(--radius-btn) !important;
      padding: 8px 24px !important;
      font-size: 14px !important;
      font-weight: 600 !important;
    }
    .swagger-ui .auth-btn-wrapper .btn-done:hover { background: var(--primary-container) !important; }
    .swagger-ui .auth-btn-wrapper .btn-done:active { transform: scale(.97) !important; }

    /* ---- Inputs ---- */
    .swagger-ui input[type=text],
    .swagger-ui input[type=email],
    .swagger-ui input[type=password] {
      background: var(--surface-container) !important;
      border: 1px solid var(--outline-variant) !important;
      border-radius: var(--radius-field) !important;
      padding: 10px 14px !important;
      font-size: 14px !important;
      font-family: inherit !important;
    }
    .swagger-ui input[type=text]:focus,
    .swagger-ui input[type=email]:focus,
    .swagger-ui input[type=password]:focus {
      border-color: var(--primary) !important;
      border-width: 2px !important;
      outline: none !important;
      background: rgba(126,200,227,.04) !important;
    }
    .swagger-ui textarea {
      background: var(--surface-container) !important;
      border: 1px solid var(--outline-variant) !important;
      border-radius: var(--radius-field) !important;
      font-family: "SF Mono", "Fira Code", "Fira Mono", Menlo, Consolas, monospace !important;
      font-size: 13px !important;
    }
    .swagger-ui textarea:focus { border-color: var(--primary) !important; outline: none !important; }
    .swagger-ui select {
      background: var(--surface-container) !important;
      border: 1px solid var(--outline-variant) !important;
      border-radius: var(--radius-field) !important;
      padding: 8px 12px !important;
      font-size: 14px !important;
      font-family: inherit !important;
    }

    /* ---- Errors ---- */
    .swagger-ui .errors-wrapper {
      background: var(--error-container) !important;
      border-radius: var(--radius-card) !important;
      border: 1px solid var(--error) !important;
      box-shadow: none !important;
      margin: 16px 0 !important;
      padding: 12px 20px !important;
    }
    .swagger-ui .errors-wrapper hgroup { display: flex !important; align-items: center !important; gap: 10px !important; }
    .swagger-ui .errors-wrapper .errors h4 { font-weight: 600 !important; }

    /* ---- Misc ---- */
    .swagger-ui .wrapper { max-width: 1460px !important; margin: 0 auto !important; padding: 0 24px !important; }
    .swagger-ui .loading-container { padding: 40px !important; }
    .swagger-ui .section-header { background: transparent !important; }
    .swagger-ui .section-header h3 { font-weight: 600 !important; }
    .swagger-ui .webhooks-section h3 { font-weight: 600 !important; }
    .swagger-ui .opblock-body .opblock-body .opblock-description { padding: 12px 16px !important; }

    /* ---- Scrollbar ---- */
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: var(--surface-dim); }
    ::-webkit-scrollbar-thumb { background: var(--surface-container-highest); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--outline); }

    /* ---- Code syntax highlighting ---- */
    .swagger-ui .highlight-code .line-numbers { color: var(--outline) !important; }
    .swagger-ui .highlight-code .string { color: #a8def5 !important; }
    .swagger-ui .highlight-code .number { color: #f5a8a8 !important; }
    .swagger-ui .highlight-code .keyword { color: #7ec8e3 !important; }
    .swagger-ui .highlight-code .boolean { color: #f5c8a8 !important; }
    .swagger-ui .highlight-code .function { color: #a8e3c8 !important; }
  </style>
</head>
<body>
  <div class="topbar">
    <div class="wrapper">
      <div class="topbar-wrapper">
        <a class="link" href="/">
          <span class="extrovert-logo">E</span>
          <span>Extrovert API</span>
        </a>
      </div>
    </div>
  </div>
  <div id="swagger-ui"></div>
  <script src="https://cdn.jsdelivr.net/npm/swagger-ui-dist@5.17.14/swagger-ui-bundle.js"></script>
  <script>
    SwaggerUIBundle({
      url: '/developers/openapi.json',
      dom_id: '#swagger-ui',
      deepLinking: true,
      presets: [
        SwaggerUIBundle.presets.apis,
        SwaggerUIBundle.SwaggerUIStandalonePreset,
      ],
      layout: "BaseLayout",
      showExtensions: true,
      showCommonExtensions: true,
      defaultModelsExpandDepth: -1,
    });
  </script>
</body>
</html>
