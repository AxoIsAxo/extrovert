<%- include('partials/header') %>
  <div class="card" style="display:flex;justify-content:space-between;align-items:center">
    <div>
      <h2 style="margin:0"><%= title %></h2>
      <small class="muted"><a href="/u/<%= targetUser.username %>">@<%= targetUser.username %></a></small>
    </div>
  </div>

  <% if (list.length === 0) { %>
    <div class="card empty-state">
      <div class="empty-art"><%- include('partials/rings', { size: 48, animate: true }) %></div>
      <h4><%= title %></h4>
      <p><%= emptyMsg %></p>
    </div>
  <% } else { %>
    <% list.forEach(function(u){ %>
      <div class="card user-row" style="margin-bottom:10px">
        <% if (u.avatar) { %><img src="<%= u.avatar %>" alt="" class="avatar-img"><% } else { %><div class="avatar"><%= (u.display_name || '?').slice(0,1).toUpperCase() %></div><% } %>
        <div class="info">
          <div style="display:flex;align-items:center;gap:6px">
            <a href="/u/<%= u.username %>" class="post-name"><%= u.display_name %></a>
            <% if (locals.currentUser && u.id !== currentUser.id) { %>
              <% if (u.mutual) { %>
                <a href="/chats/<%= u.username %>" class="chat-icon" title="Send a message"><%- include('partials/icon', { name: 'chat', size: 15 }) %></a>
              <% } else { %>
                <span class="chat-icon locked" title="Follow each other to start chatting"><%- include('partials/icon', { name: 'lock', size: 13 }) %></span>
              <% } %>
            <% } %>
          </div>
          <small>@<%= u.username %></small>
          <% if (u.bio) { %><div class="muted" style="font-size:0.85rem;margin-top:2px"><%= u.bio %></div><% } %>
        </div>
        <% if (locals.currentUser && u.id !== currentUser.id) { %>
          <form method="post" action="<%= u.following ? '/unfollow' : '/follow' %>/<%= u.username %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn <%= u.following ? 'ghost' : '' %> small"><% if (u.following) { %><%- include('partials/icon', { name: 'check', size: 14 }) %> Following<% } else { %><%- include('partials/icon', { name: 'plus', size: 14 }) %> Follow<% } %></button>
          </form>
        <% } %>
      </div>
    <% }) %>
  <% } %>
<%- include('partials/footer') %>