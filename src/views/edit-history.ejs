<%- include('partials/header') %>
  <div class="card">
    <a href="<%= post ? '/posts/' + post.id : '/' %>" class="muted" style="font-size:0.85rem">← Back</a>
    <h2 style="margin:0.5rem 0">Edit History</h2>
    <% if (history.length === 0) { %>
      <p class="muted">No edit history available.</p>
    <% } else { %>
      <div style="margin-top:1rem">
        <% history.forEach(function(h){ %>
          <div class="edit-history-entry" style="padding:0.75rem;margin-bottom:0.5rem;background:var(--surface-container);border-radius:8px">
            <div style="font-size:0.85rem;margin-bottom:0.25rem">
              <strong><%= h.display_name %></strong> <span class="muted">@<%= h.username %></span>
              <span class="muted">· <%= new Date(h.edited_at).toLocaleString() %></span>
            </div>
            <div style="display:flex;gap:1rem;flex-wrap:wrap">
              <div style="flex:1;min-width:200px">
                <small class="muted">Before:</small>
                <div style="padding:0.25rem 0.5rem;background:var(--surface-container-high);border-radius:4px;margin-top:2px;white-space:pre-wrap"><%= h.old_body %></div>
              </div>
              <div style="flex:1;min-width:200px">
                <small class="muted">After:</small>
                <div style="padding:0.25rem 0.5rem;background:var(--surface-container-high);border-radius:4px;margin-top:2px;white-space:pre-wrap"><%= h.new_body %></div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
<%- include('partials/footer') %>