<%- include('partials/header') %>
  <div class="card" style="max-width:400px;margin:0 auto">
    <h2>Settings</h2>
    <form method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Theme</label>
      <select name="theme">
        <option value="dark" <%= theme === 'dark' ? 'selected' : '' %>>Earthy Dark</option>
        <option value="light" <%= theme === 'light' ? 'selected' : '' %>>Earthy Light</option>
      </select>
      <button class="btn" style="width:100%;margin-top:16px">Save</button>
    </form>
    <hr style="border:none;border-top:2px solid var(--border-light);margin:24px 0">
    <a class="btn" href="/settings/developers" style="display:block;text-align:center;margin-bottom:8px">Developer Applications</a>
    <a class="btn" href="/developers/docs" style="display:block;text-align:center;margin-bottom:8px">API Documentation</a>
    <a class="btn danger" href="/settings/delete" style="display:block;text-align:center">Delete account</a>
  </div>
<%- include('partials/footer') %>
