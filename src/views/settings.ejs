<%- include('partials/header') %>
  <div class="card" style="max-width:420px;margin:0 auto">
    <h2>Settings</h2>
    <form method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Theme</label>
      <select name="theme">
        <option value="dark" <%= theme === 'dark' ? 'selected' : '' %>>Dark · Ink</option>
        <option value="light" <%= theme === 'light' ? 'selected' : '' %>>Light · Lavender</option>
      </select>
      <button class="btn full" style="margin-top:18px">Save</button>
    </form>
    <hr>
    <a class="btn ghost full" href="/settings/developers" style="margin-bottom:8px"><%- include('partials/icon', { name: 'key', size: 15 }) %> Developer applications</a>
    <a class="btn ghost full" href="/developers/docs" style="margin-bottom:8px"><%- include('partials/icon', { name: 'doc', size: 15 }) %> API documentation</a>
    <a class="btn ghost danger full" href="/settings/delete"><%- include('partials/icon', { name: 'trash', size: 15 }) %> Delete account</a>
    <div class="muted" style="text-align:center;font-size:0.75rem;margin-top:16px;padding-top:12px;border-top:1px solid var(--border)">
      Extrovert &mdash; &ldquo;Embrace&rdquo; v<%= version %>
    </div>
  </div>
<%- include('partials/footer') %>