<%- include('partials/header') %>
  <div class="card" style="max-width:400px;margin:0 auto">
    <h2>Settings</h2>
    <form method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label style="display:block;margin-bottom:4px;font-weight:600">Theme</label>
      <select name="theme" style="width:100%;padding:10px;margin-bottom:14px">
        <option value="default" <%= theme === 'default' ? 'selected' : '' %>>Default (Dark)</option>
        <option value="neobrutalism" <%= theme === 'neobrutalism' ? 'selected' : '' %>>Neobrutalism</option>
      </select>
      <button class="btn" style="width:100%">Save</button>
    </form>
    <hr style="border:none;border-top:1px solid var(--outline-variant);margin:24px 0">
    <a class="btn" href="/settings/developers" style="display:block;text-align:center;margin-bottom:8px">Developer Applications</a>
    <a class="btn" href="/developers/docs" style="display:block;text-align:center;margin-bottom:8px">API Documentation</a>
    <a class="btn danger" href="/settings/delete" style="display:block;text-align:center">Delete account</a>
  </div>
<%- include('partials/footer') %>
